# SpaceNet GUI environment configuration
# Copy this file to `.env` and adjust values for your local setup.

# Base URL of the SpaceNet backend API.
# In local Docker Compose the backend is exposed on host port 5000.
# NOTE: NEXT_PUBLIC_ variables are inlined at build time — when building
# the production Docker image, pass this as a build ARG so it lands in
# the client bundle.
NEXT_PUBLIC_API_URL=http://localhost:5000
