# SpaceNet root environment file (used by docker-compose.yml)
# Copy this file to `.env` and change the credentials for anything
# beyond a local, single-user development setup.

# Postgres credentials. These are wired into the `db` compose service and
# also referenced by DATABASE_URL below (both must agree).
POSTGRES_USER=spacenet_user
POSTGRES_PASSWORD=change-me-in-real-deployments
POSTGRES_DB=spacenet_db

# Full SQLAlchemy connection URL used by the Flask backend.
# In Docker Compose the hostname `db` resolves to the Postgres container.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Optional. Overrides the default Redis URL if your setup differs from
# the docker-compose service name.
# RQ_REDIS_URL=redis://redis:6379/0
